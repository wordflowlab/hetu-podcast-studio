{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 170
    },
    "brief": {
      "type": "string",
      "minLength": 0,
      "maxLength": 8000
    },
    "recordings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "asset_source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "source_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "title",
          "asset_source_index",
          "source_note"
        ]
      },
      "maxItems": 8
    },
    "cues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "in_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3600000
          },
          "out_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600000
          },
          "speaker": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "source_index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "byte_start": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "byte_end": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100000000
          },
          "quote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 16000
          },
          "timing_note": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "recording_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        },
        "required": [
          "id",
          "title",
          "recording_id",
          "in_ms",
          "out_ms",
          "speaker",
          "source_index",
          "byte_start",
          "byte_end",
          "quote",
          "timing_note"
        ]
      },
      "maxItems": 300
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "order": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "host_text": {
            "type": "string",
            "minLength": 0,
            "maxLength": 20000
          },
          "intent": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "title",
          "order",
          "host_text",
          "intent"
        ]
      },
      "maxItems": 100
    },
    "editions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "order": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 300
                },
                "section_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "kind": {
                  "enum": [
                    "cue",
                    "silence"
                  ]
                },
                "cue_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "silence_ms": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 300000
                }
              },
              "required": [
                "id",
                "order",
                "section_id",
                "kind",
                "cue_id",
                "silence_ms"
              ]
            },
            "maxItems": 300
          },
          "basis_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "rationale": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "title",
          "items",
          "basis_sha256",
          "rationale"
        ]
      },
      "maxItems": 40
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target_kind": {
            "enum": [
              "edition",
              "section",
              "cue"
            ]
          },
          "target_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "target_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "origin": {
            "enum": [
              "author",
              "agent"
            ]
          },
          "comment": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          },
          "status": {
            "enum": [
              "open",
              "resolved"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 0,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "target_kind",
          "target_id",
          "target_sha256",
          "origin",
          "comment",
          "status",
          "resolution"
        ]
      },
      "maxItems": 300
    },
    "basis_refs": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owner_plugin_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "object_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "revision": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "owner_plugin_id",
          "object_id",
          "revision",
          "sha256"
        ]
      }
    }
  },
  "required": [
    "format_version",
    "title",
    "brief",
    "recordings",
    "cues",
    "sections",
    "editions",
    "notes",
    "basis_refs"
  ]
}
